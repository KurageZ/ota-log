{
  "expo": {
    "name": "ota log",
    "slug": "ota-log",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "otalog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.otalog.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true
      },
      "appleTeamId": "BP9RKVU242"
    },
    "android": {
      "versionCode": 10500,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.otalog.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-calendar",
        {
          "calendarPermission": "ota log 需要访问系统日历，用于将活动加入你的日程。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ota log 需要访问相机，用于拍摄带有拍立得贴纸的照片。",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "ota log 需要访问照片，用于选择拍立得贴纸。",
          "savePhotosPermission": "ota log 需要将生成的贴纸照片保存到你的相册。",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "./plugins/with-expo-widgets-no-push",
      "./plugins/with-cheki-widget-string-slot",
      [
        "expo-widgets",
        {
          "enableAndroid": false,
          "widgets": [
            {
              "name": "ChekiPhotoWidget",
              "displayName": "拍立得回忆",
              "description": "展示电子切册中的拍立得照片",
                "ios": {
                  "supportedFamilies": [
                    "systemSmall",
                    "systemMedium"
                  ],
                "contentMarginsDisabled": true,
                "configuration": {
                  "title": "选择拍立得分组",
                  "description": "选择此小组件展示的分组",
                  "parameters": {
                    "slot": {
                      "title": "分组",
                      "type": "enum",
                      "values": [
                        { "name": "分组 1", "value": "group1" },
                        { "name": "分组 2", "value": "group2" },
                        { "name": "分组 3", "value": "group3" },
                        { "name": "分组 4", "value": "group4" },
                        { "name": "分组 5", "value": "group5" },
                        { "name": "分组 6", "value": "group6" }
                      ],
                      "default": "group1"
                    }
                  }
                }
              }
            },
            {
              "name": "NextEventWidget",
              "displayName": "下一场活动",
              "description": "查看下一场计划中的活动",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.otalog.app.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.otalog.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "e488e346-d304-40d2-8ae5-073b2af93541"
      }
    },
    "owner": "kuragez"
  }
}
