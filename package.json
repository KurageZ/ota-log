{
  "name": "ota-log",
  "version": "1.5.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "npm run start:dev",
    "start:dev": "APP_VARIANT=development expo start --dev-client",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "npm run ios:dev",
    "ios:dev": "APP_VARIANT=development expo run:ios",
    "prebuild:ios:dev": "APP_VARIANT=development expo prebuild --platform ios --clean",
    "web": "expo start --web",
    "test": "jest",
    "test:announcement-parse": "jest --runInBand src/utils/__tests__/parseAnnouncement.test.ts",
    "postinstall": "node scripts/patch-react-native-image-viewing.js && node scripts/patch-react-native-cookies.js"
  },
  "dependencies": {
    "@expo/ui": "~57.0.11",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-cookies/cookies": "^6.2.1",
    "@react-native-vector-icons/lucide": "^13.1.2",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "^57.0.13",
    "expo-asset": "~57.0.11",
    "expo-build-properties": "~57.0.11",
    "expo-calendar": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.12",
    "expo-file-system": "~57.0.4",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.10",
    "expo-image-picker": "~57.0.10",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-media-library": "~57.0.4",
    "expo-router": "~57.0.13",
    "expo-sharing": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-widgets": "~57.0.10",
    "jszip": "^3.10.1",
    "lucide-react-native": "^1.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-calendars": "^1.1314.0",
    "react-native-chart-kit": "^7.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-image-colors": "^2.6.0",
    "react-native-image-viewing": "^0.2.2",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "4.5.1",
    "react-native-reanimated-dnd": "^2.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-native-zip-archive": "^8.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "better-sqlite3": "^12.10.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-cookies/cookies"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true
}
