{
  "cli": {
    "version": ">= 18.12.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview"
      }
    },
    "beta": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "beta"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "beta": {},
    "production": {}
  }
}
